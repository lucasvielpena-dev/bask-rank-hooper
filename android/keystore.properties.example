# ---------------------------------------------------------------
#  Modelo da assinatura de release (Play Store)
# ---------------------------------------------------------------
#  COMO USAR
#  1. Copie este arquivo para  android/keystore.properties
#  2. Crie o keystore (uma unica vez, guarde a senha para sempre):
#
#       keytool -genkeypair -v -keystore upload-keystore.jks ^
#         -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
#     O keytool fica em: C:\Program Files\Android\Android Studio\jbr\bin\keytool.exe
#     Gere o arquivo em  android/upload-keystore.jks
#
#  3. Preencha os campos abaixo com o que voce digitou no keytool
#  4. Gere o AAB:  npx cap sync android  &&  cd android  &&  gradlew bundleRelease
#     Saida: android/app/build/outputs/bundle/release/app-release.aab
#
#  ATENCAO: o arquivo keystore.properties e o .jks NAO sao versionados
#  (ja estao no android/.gitignore). Guarde um backup dos dois fora do PC.
#  Se perder o keystore, so consegue publicar de novo pedindo reset a Google.
#  ATIVE O "Play App Signing" no Console: a Google guarda a chave de
#  distribuicao e este keystore passa a ser apenas a "upload key".
# ---------------------------------------------------------------

storeFile=upload-keystore.jks
storePassword=COLOQUE_A_SENHA_DO_KEYSTORE
keyAlias=upload
keyPassword=COLOQUE_A_SENHA_DA_CHAVE
